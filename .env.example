# Copy to .env for local development. Never commit the real file.

# Which spaCy model to serve. Must exist in the bucket as
# s3://$S3_BUCKET/$S3_PREFIX/$SPACY_MODEL.tar.gz
SPACY_MODEL=en_core_web_sm-3.7.1

# s3 | local | github  (see nlp_lambda/model_source.py)
MODEL_SOURCE=s3
S3_BUCKET=your-model-bucket
S3_PREFIX=models
# Point at MinIO/LocalStack instead of AWS. Leave unset for real S3.
# S3_ENDPOINT_URL=http://localhost:8321

# Where the unpacked model lives. On Lambda this must be under /tmp.
MODEL_CACHE_DIR=/tmp/models
# Used when MODEL_SOURCE=local
# LOCAL_MODEL_ROOT=./models

# Request limits
MAX_TEXT_CHARS=100000
MAX_BATCH_SIZE=32

# Optional. Omit and error reporting is simply disabled.
# SENTRY_DSN=
LOG_LEVEL=INFO
